def bubble_sort(arr):
    n = len(arr)
    for i in range(n):
        swapped = False
        for j in range(0 , n - i - 1):
            if arr[j] > arr[j + 1]:
                arr[j],arr[j + 1] = arr[j + 1], arr[j]
                swapped = True
        if not swapped:
            break
    return arr
    
    
def heapify(arr, n, i):
    largest = i
    left = i * 2 + 1
    right = i * 2 + 2
    if left < n and arr[left] > arr[largest]:
        largest = left
    if right < n and arr[right] > arr[largest]:
        largest = right
    if largest != i:
        arr[i], arr[largest] = arr[largest],arr[i]
        heapify(arr, n , largest)

def heap_sort(arr):
    n = len(arr)
    for i in range(n // 2 - 1, -1 ,-1):
        heapify(arr, n, i)
    for i in range(n - 1, 0, -1):
        arr[0],arr[i] = arr[i],arr[0]
        heapify(arr, i, 0)

def bucket_sort(arr):
    n = len(arr)
    result = []
    if n <= 1:
        return arr
    buckets = [[] for _ in range(n)]
    for num in arr:
        index = int(num * n)
        buckets[index].append(num)
    for bucket in buckets:
        bucket.sort()
    for bucket in buckets:
        result.extend(bucket)
    return result
    

def merge(left, right):
    i = j = 0
    result = []
    while i < len(left) and j < len(right):
        if left[i] < right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1
    result.extend(left[i:])
    result.extend(right[j:])
    return result
    

    
def merge_sort(arr):
    if len(arr) <= 1:
        return arr
    i = len(arr) // 2
    left_half = arr[:i]
    right_half = arr[i:]
    left_sorted = merge_sort(left_half)
    right_sorted = merge_sort(right_half)
    return merge(left_sorted,right_sorted)
    
    
    
def shell_sort(arr):
    n = len(arr)        # Start with a large gap, then reduce the gap
    gap = n // 2        # Initial gap value
    while gap > 0:      # Keep reducing the gap until it becomes 0
        for i in range(gap, n):     # Perform a gapped insertion sort for this gap size
            temp = arr[i]           # Save the current element to be inserted
            j = i
            while j >= gap and arr[j - gap] > temp: 
                arr[j] = arr[j - gap]
                j -= gap
            arr[j] = temp    # Insert the current element into its correct position
        gap //= 2            # Reduce the gap for the next iteration

def counting_sort(arr, exp):
    n = len(arr)
    output = [0] * n                # Output array that will hold sorted numbers
    count = [0] * 10                # Count array to store the frequency of digits (0-9)
    for i in range(n):              # Store the count of occurrences of (arr[i] // exp) % 10 in count[]
        index = (arr[i] // exp) % 10
        count[index] += 1
    for i in range(1, 10):          # Change count[i] to contain  position of this digit in output[]
        count[i] += count[i - 1]
    i = n - 1                       # Create output array, placing elements in their sorted position
    while i >= 0:
        index = (arr[i] // exp) % 10
        output[count[index] - 1] = arr[i]
        count[index] -= 1
        i -= 1
    for i in range(n):              # Copy the sorted elements back into the original array
        arr[i] = output[i]


def radix_sort(arr):                # Radix Sort: Main function to perform radix sort
    max_num = max(arr)              # Find the maximum number to determine the number of digits
    exp = 1                         # Initialize exponent (1's, 10's, 100's, etc.)
    while max_num // exp > 0:
        counting_sort(arr, exp)     # Sort by current digit
        exp *= 10                   # Move to the next digit

